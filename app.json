{
  "expo": {
    "name": "Boma",
    "slug": "boma-app",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bomaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boma.app"
    },
    "android": {
      "package": "com.boma.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2E3",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/boma-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2E3",
          "dark": {
            "image": "./assets/images/boma-logo.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#F2F2E3"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Boma uses your photos so you can attach a receipt to an expense.",
          "cameraPermission": "Boma uses the camera so you can photograph a receipt.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#115238"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27a776e6-321a-48c0-9ac3-81cc36414d21"
      }
    }
  }
}
